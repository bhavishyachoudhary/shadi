# Browser API base path. Vite proxies /api to http://localhost:3001 in development.
VITE_API_BASE_URL=/api/v1

# Mock profile records and demo auth are permitted only in Vite development mode.
VITE_ENABLE_DEMO_DATA=true
VITE_ENABLE_DEMO_AUTH=true
VITE_DEMO_SHOW_ALL_GENDERS=true

# Keep disabled until the production OAuth callback is configured.
VITE_ENABLE_GOOGLE_AUTH=false
