PORT=3001
NODE_ENV=development

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=bandhan_user
DB_PASS=replace_with_a_strong_password
DB_NAME=bandhan_db
DB_POOL_MAX=5
DB_LOG_SQL=false

# Development only. Deployed environments must use versioned migrations.
DB_SYNC=false

# JWT/session configuration (replace with long random values)
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace_with_a_different_long_random_value

# Development fixtures (never enable in production)
ENABLE_DEMO_AUTH=true
DEMO_AUTH_USE_DATABASE=false
ALLOW_MOCK_SEED=false
MOCK_SEED_SYNC=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# SMS OTP (MSG91)
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=BNDHAN
MSG91_TEMPLATE_ID=your_otp_template_id

# Exact comma-separated browser origins allowed by CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Temporary local upload storage. Private object storage replaces this for production privacy controls.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
