PORT=3001
NODE_ENV=development

# MySQL Database (GoDaddy cPanel MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=bandhan_user
DB_PASS=YourStrongPassword123!
DB_NAME=bandhan_db

# JWT Configuration
JWT_SECRET=bandhan_shaadi_jwt_secret_2025_min32chars!!
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SMS OTP (MSG91 India)
# Get from: https://msg91.com/
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=BNDHAN
MSG91_TEMPLATE_ID=your_otp_template_id

# Session Secret
SESSION_SECRET=bandhan_session_secret_2025!!

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
